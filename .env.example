# ==============================================================
# LearnLoop Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================

# Set to "remote" to connect to the FastAPI backend.
# Set to "local" to run the adaptive engine entirely in-browser (no backend required).
VITE_ADAPTIVE_MODE=remote

# URL of the running FastAPI backend.
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production (Railway example — replace with your actual backend domain):
# VITE_API_BASE_URL=https://learnloop-backend.up.railway.app
