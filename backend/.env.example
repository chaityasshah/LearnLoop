# ==============================================================
# LearnLoop Backend — Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# ==============================================================

# Environment mode: "development", "pilot", or "production"
# In "pilot" mode, ML is forced off and SQLite is rejected.
APP_ENV=pilot

# PostgreSQL connection string.
# Local development example:
DATABASE_URL=postgresql://user:password@localhost:5432/learnloop
# Railway PostgreSQL example (Railway injects this automatically when linked):
# DATABASE_URL=postgresql://postgres:<password>@<host>.railway.internal:5432/railway

# Study Buddy — Groq LLM API key (backend-only, never expose to frontend)
GROQ_API_KEY=your_groq_api_key_here

# Machine Learning Candidate Pipeline — MUST remain False for V1 production
ML_ENABLED=False

# CORS: URL of the deployed frontend (no trailing slash).
# Required in production so the browser can reach the API.
# Local development localhost origins are always allowed automatically.
# Example:
# FRONTEND_ORIGIN=https://learnloop-frontend.up.railway.app
FRONTEND_ORIGIN=
